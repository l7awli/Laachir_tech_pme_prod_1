# Copy this to .env for local development (never commit .env to git)

# REQUIRED: Generate a strong random secret key
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Database URL
# SQLite (local dev / Railway with a volume):
DATABASE_URL=sqlite:///laachir_tech.db
# PostgreSQL (Neon / Supabase / Railway PostgreSQL addon):
# DATABASE_URL=postgresql://user:password@host/dbname

FLASK_ENV=production
